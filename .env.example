# Anthropic-compatible endpoint
ANTHROPIC_BASE_URL=https://api.example.com/anthropic

# Use either API key or bearer token
ANTHROPIC_API_KEY=sk-your-api-key
ANTHROPIC_AUTH_TOKEN=sk-your-bearer-token

# Model mapping
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-default-model
ANTHROPIC_DEFAULT_OPUS_MODEL=your-default-model
ANTHROPIC_DEFAULT_SONNET_MODEL=your-default-model
ANTHROPIC_MODEL=your-default-model

# Runtime behavior
API_TIMEOUT_MS=3000000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
DISABLE_TELEMETRY=1

# Optional local metadata
CLAUDE_CODE_LOCAL_VERSION=1.0.0-fusion
CLAUDE_CODE_LOCAL_PACKAGE_URL=claude-code-fusion
