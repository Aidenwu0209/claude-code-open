#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

BUN_BIN="${BUN:-}"
if [[ -z "$BUN_BIN" ]]; then
  if command -v bun >/dev/null 2>&1; then
    BUN_BIN="$(command -v bun)"
  elif [[ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun" ]]; then
    BUN_BIN="${BUN_INSTALL:-$HOME/.bun}/bin/bun"
  else
    echo "bun is required but was not found in PATH or ~/.bun/bin/bun" >&2
    exit 127
  fi
fi

# Force recovery CLI (simple readline REPL, no Ink TUI)
if [[ "${CLAUDE_CODE_FORCE_RECOVERY_CLI:-0}" == "1" ]]; then
  exec "$BUN_BIN" --preload ./preload.ts --env-file=.env ./src/localRecoveryCli.ts "$@"
fi

# Optional launcher that keeps the main dev path untouched while
# still allowing preload metadata and env wiring.
exec "$BUN_BIN" --preload ./preload.ts --env-file=.env ./src/entrypoints/cli.tsx "$@"
